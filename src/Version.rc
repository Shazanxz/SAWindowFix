#include <winresrc.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
 PRODUCTVERSION MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  MOD_DESCRIPTION
            VALUE "FileVersion",      MOD_VERSION
            VALUE "InternalName",     MOD_NAME
            VALUE "LegalCopyright",   "Copyright (c) 2026 Shazanxz - PolyForm Noncommercial 1.0.0"
            VALUE "OriginalFilename", MOD_NAME ".asi"
            VALUE "ProductName",      MOD_NAME
            VALUE "ProductVersion",   MOD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
